# Required
DISCORD_BOT_TOKEN=your_discord_bot_token_here
TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# Optional - comma separated Discord channel IDs for daily auto-signals
SIGNAL_CHANNEL_IDS=

# Optional - comma separated symbols to scan daily (default: XAU/USD,EUR/USD,GBP/USD,USD/JPY,AUD/USD)
WATCHLIST=XAU/USD,EUR/USD,GBP/USD,USD/JPY,AUD/USD

# Optional - timezone for scheduling (default: UTC)
TIMEZONE=UTC

# Optional - log level
LOG_LEVEL=INFO
